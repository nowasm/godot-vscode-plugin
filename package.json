		"@vscode/debugadapter": "^1.68.0",
		"@vscode/debugprotocol": "^1.68.0",
		"await-notify": "^1.0.1",
		"bbcode-to-ansi": "^1.0.0",
		"global": "^4.4.0",
		"marked": "^4.0.11",
		"net": "^1.0.2",
		"prismjs": "^1.30.0",
		"terminate": "^2.5.0",
		"vscode-languageclient": "^9.0.1",
		"vscode-oniguruma": "^2.0.1",
		"vscode-textmate": "^9.0.0",
		"ws": "^8.17.1",
		"ya-bbcode": "^4.0.0"
	}
